# ---------------------------------------------------------------- environments
.venv/
venv/
env/
.env

# ---------------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.pytest_cache/

# ------------------------------------------------------------------- notebooks
.ipynb_checkpoints/
*.ipynb

# ------------------------------------------------------- generated by the runs
# Everything the pipeline writes: transitions, checkpoints, agent runs, plots.
# The tree stays local -- it is reproducible from the sbatch files.
results/
results_archive/
logs/
runs/
wandb/

# Model weights and bulk data, wherever they land.
*.pt
*.pth
*.ckpt
*.npz
*.pkl
*.SG

# Raw dataset downloads, written by the data/datasets/ loaders.
data/raw/

# Third-party baseline repos, fetched by baselines/setup_baselines.py.
baselines/external/

# Pre-reorganization location, kept ignored so old trees do not get committed.
data/output/

# ------------------------------------------------------------- local scratch
.claude/
CLAUDE.md
research_notes/
docs/

# ----------------------------------------------------------------- OS and IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---------------------------------------------------------------- docs/ policy
# docs/ began as a scratch area and is ignored by default, but the reports in it
# are deliverables. The negation must come AFTER the `docs/` rule and must also
# re-include the directory itself -- git never descends into an excluded
# directory, so `!docs/*.md` alone would never be consulted.
!docs/
docs/*
!docs/*.md
!docs/*.json
